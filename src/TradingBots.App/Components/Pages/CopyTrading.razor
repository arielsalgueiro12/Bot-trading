@page "/copy-trading"
@using System.Globalization
@using TradingBots.App.Services.CopyMirror
@inject ICopyMirrorService Mirror
@inject IServiceScopeFactory ScopeFactory
@implements IAsyncDisposable

<PageTitle>Copy Trading</PageTitle>

<h1 class="tb-page-title">Copy Mirror</h1>
<p class="tb-page-lead text-muted mb-3">
    Mirror unificado: copia <strong>LONG y SHORT</strong> igual que el lead.
    Modo recomendado <strong>Match lead</strong> → Futures primero; Spot solo si el par no cotiza en Futures.
</p>

<div class="alert alert-secondary border-0 small mb-4" role="status">
    Requiere keys Futures en Settings (demo.binance.com). Spot y Futures son wallets/keys distintas en Sandbox.
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="alert alert-success">@_info</div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(_boardTab == BoardTab.Spot ? "active" : null)"
                                @onclick="SwitchToSpotBoardAsync">
                            Listado Spot
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button"
                                class="nav-link @(_boardTab == BoardTab.Futures ? "active" : null)"
                                @onclick="SwitchToFuturesBoardAsync">
                            Listado Futures
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0">
                <div class="d-flex justify-content-between align-items-start gap-2 px-3 pt-3">
                    <p class="small text-muted mb-0">
                        @if (_boardTab == BoardTab.Spot)
                        {
                            <span>Leads con pares Spot recientes → wallet <strong>Spot</strong>. Venue sugerido: Spot only.</span>
                        }
                        else
                        {
                            <span>Ranking Futures 30D. Ordena por <strong>PnL</strong> (recomendado) o busca por nick.</span>
                        }
                    </p>
                    <button class="btn btn-sm btn-outline-light flex-shrink-0" type="button"
                            @onclick="ReloadCurrentBoardAsync" disabled="@_loadingBoard">
                        @(_loadingBoard ? "Cargando..." : "Actualizar")
                    </button>
                </div>
                @if (_boardTab == BoardTab.Futures)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-end px-3 pt-2">
                        <div style="min-width:7rem">
                            <label class="form-label small mb-1">Orden</label>
                            <select class="form-select form-select-sm" @bind="_futuresSort">
                                <option value="PNL">PnL 30D</option>
                                <option value="ROI">ROI 30D</option>
                                <option value="MDD">MDD 30D</option>
                            </select>
                        </div>
                        <div class="flex-grow-1" style="min-width:10rem">
                            <label class="form-label small mb-1">Buscar nick</label>
                            <input class="form-control form-control-sm" @bind="_futuresNickname"
                                   placeholder="ej. 金木爱交易 / 持久稳定" />
                        </div>
                        <button class="btn btn-sm btn-primary" type="button"
                                @onclick="LoadFuturesBoardAsync" disabled="@_loadingBoard">
                            Buscar
                        </button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_boardNote))
                {
                    <p class="small text-muted px-3 pt-2 mb-0">@_boardNote</p>
                }
                @if (_leads.Count == 0)
                {
                    <p class="text-muted small p-3 mb-0">
                        @(_loadingBoard
                            ? (_boardTab == BoardTab.Spot
                                ? "Filtrando historial + simbolos Spot (~30–60s)..."
                                : "Cargando ranking Futures...")
                            : "Pulsa Actualizar para cargar el listado.")
                    </p>
                }
                else
                {
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead>
                            <tr>
                                <th>Lead</th>
                                <th>@(_boardTab == BoardTab.Spot ? "Simbolos Spot" : "AUM")</th>
                                <th class="text-end">ROI%</th>
                                <th class="text-end">PnL</th>
                                <th class="text-end">MDD</th>
                                <th class="text-end">Copiers</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var lead in _leads)
                            {
                                <tr class="@(Selected(lead) ? "table-active" : null)">
                                    <td>
                                        <div class="fw-semibold">@lead.Nickname</div>
                                        <div class="text-muted small">@ShortId(lead.LeadPortfolioId)</div>
                                    </td>
                                    <td class="small">
                                        @if (_boardTab == BoardTab.Spot)
                                        {
                                            @(string.IsNullOrWhiteSpace(lead.SpotSymbolsSample) ? "—" : lead.SpotSymbolsSample)
                                        }
                                        else
                                        {
                                            @lead.Aum.ToString("0")
                                        }
                                    </td>
                                    <td class="text-end">@lead.Roi.ToString("0.0")</td>
                                    <td class="text-end">@lead.Pnl.ToString("0")</td>
                                    <td class="text-end">@lead.Mdd.ToString("0.0")</td>
                                    <td class="text-end">@lead.CurrentCopyCount/@lead.MaxCopyCount</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" type="button"
                                                @onclick="() => SelectLead(lead)">
                                            Usar
                                        </button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Activar mirror</div>
            <div class="card-body d-flex flex-column gap-3">
                <div>
                    <label class="form-label small mb-1">Lead portfolio ID</label>
                    <input class="form-control form-control-sm"
                           value="@_form.LeadPortfolioId"
                           @oninput="OnPortfolioIdInput"
                           placeholder="pulsa Usar en un lead (ID numerico completo)" />
                    @if (!string.IsNullOrWhiteSpace(_form.LeadNickname))
                    {
                        <div class="form-text">Seleccionado: @_form.LeadNickname</div>
                    }
                    else if (string.IsNullOrWhiteSpace(_form.LeadPortfolioId))
                    {
                        <div class="form-text text-warning">Primero pulsa <strong>Usar</strong> en un lead de la lista.</div>
                    }
                </div>

                <div>
                    <label class="form-label small mb-1">Wallet / venue</label>
                    <select class="form-select form-select-sm" @bind="_form.VenueMode">
                        <option value="@CopyMirrorVenueMode.Auto">Match lead (Futures + Spot fallback)</option>
                        <option value="@CopyMirrorVenueMode.FuturesOnly">Solo Futures</option>
                        <option value="@CopyMirrorVenueMode.SpotOnly">Solo Spot (sin shorts)</option>
                    </select>
                    <div class="form-text">@VenueHelp(_form.VenueMode)</div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small mb-1">USDT por trade</label>
                        <input class="form-control form-control-sm" type="number" min="20" step="1"
                               @bind="_form.QuotePerTradeUsdt"
                               @bind:event="oninput"
                               @bind:culture="CultureInfo.InvariantCulture" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small mb-1">Max posiciones abiertas</label>
                        <input class="form-control form-control-sm" type="number" min="1" max="20" step="1"
                               @bind="_form.MaxOpenPositions"
                               @bind:event="oninput"
                               @bind:culture="CultureInfo.InvariantCulture" />
                        <div class="form-text">Con ~100 USDT y 30/trade → 3.</div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small mb-1">Poll (ms)</label>
                        <input class="form-control form-control-sm" type="number" min="2500" step="500"
                               @bind="_form.PollIntervalMs" @bind:event="oninput"
                               @bind:culture="CultureInfo.InvariantCulture" />
                    </div>
                    @if (_form.VenueMode != CopyMirrorVenueMode.SpotOnly)
                    {
                        <div class="col-6">
                            <label class="form-label small mb-1">Leverage Futures (1–5)</label>
                            <input class="form-control form-control-sm" type="number" min="1" max="5" step="1"
                                   @bind="_form.FuturesLeverage" @bind:event="oninput"
                                   @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                    }
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="dryRun" @bind="_form.DryRun" />
                    <label class="form-check-label" for="dryRun">Dry-run (solo log, sin ordenes)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="longOnly" @bind="_form.LongOnly" />
                    <label class="form-check-label" for="longOnly">Solo LONG (desactivado = copia también shorts del lead)</label>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="button" @onclick="StartAsync"
                            disabled="@(!CanStart || _starting)">
                        @(_starting ? "Iniciando..." : "Añadir / iniciar mirror")
                    </button>
                    <button class="btn btn-outline-light" type="button" @onclick="StopAllAsync" disabled="@_starting">
                        Detener todos
                    </button>
                </div>
                <p class="small text-muted mb-0">
                    Hasta @CopyMirrorStatus.MaxConcurrentMirrors mirrors. Cada uno puede usar venue distinto
                    (Spot y Futures a la vez).
                </p>
            </div>
        </div>
    </div>
</div>

@{
    var st = Mirror.GetStatus();
}
<div class="card mb-4">
    <div class="card-header">Mirrors activos (@st.ActiveCount / @st.MaxConcurrent)</div>
    <div class="card-body p-0">
        @if (st.Sessions.Count == 0)
        {
            <p class="text-muted small p-3 mb-0">Ningun mirror activo. Elige un lead y pulsa Añadir / iniciar.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Modo</th>
                        <th>Venue / wallet</th>
                        <th class="text-end">USDT</th>
                        <th class="text-end">Max open</th>
                        <th>Warm-up</th>
                        <th>Poll</th>
                        <th class="text-end">Buy/Sell/Skip</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in st.Sessions)
                    {
                        var selected = string.Equals(_selectedLeadId, s.Settings.LeadPortfolioId, StringComparison.Ordinal);
                        <tr class="@(selected ? "table-active" : null)" style="cursor:pointer"
                            @onclick="() => ToggleMirrorDetail(s.Settings.LeadPortfolioId)">
                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(s.Settings.LeadNickname) ? ShortId(s.Settings.LeadPortfolioId) : s.Settings.LeadNickname)</div>
                                <div class="text-muted small">@ShortId(s.Settings.LeadPortfolioId)</div>
                                @if (!string.IsNullOrWhiteSpace(s.LastError))
                                {
                                    <div class="text-danger small">@s.LastError</div>
                                }
                            </td>
                            <td>@(s.Settings.DryRun ? "dry-run" : "LIVE")</td>
                            <td class="small">
                                @VenueLabel(s.Settings.VenueMode)
                                @if (s.Settings.VenueMode != CopyMirrorVenueMode.SpotOnly)
                                {
                                    <span> x@(s.Settings.FuturesLeverage)</span>
                                }
                                <span>@(s.Settings.LongOnly ? " · L" : " · L/S")</span>
                            </td>
                            <td class="text-end">@s.Settings.QuotePerTradeUsdt.ToString("0.##")</td>
                            <td class="text-end">@s.Settings.MaxOpenPositions</td>
                            <td>@(s.WarmingUp ? "si" : "no")</td>
                            <td class="small">@(s.LastPollUtc?.ToString("HH:mm:ss") ?? "—")</td>
                            <td class="text-end">@s.MirroredBuys / @s.MirroredSells / @s.Skipped</td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <button class="btn btn-sm btn-outline-primary me-1" type="button"
                                        @onclick="() => ToggleMirrorDetail(s.Settings.LeadPortfolioId)">
                                    @(selected ? "Cerrar" : "Ver")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" type="button"
                                        @onclick="() => StopOneAsync(s.Settings.LeadPortfolioId)">
                                    Detener
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@{
    var selectedSession = string.IsNullOrWhiteSpace(_selectedLeadId)
        ? null
        : st.Sessions.FirstOrDefault(x => string.Equals(x.Settings.LeadPortfolioId, _selectedLeadId, StringComparison.Ordinal));
    var detailEvents = Mirror.GetEvents(_selectedLeadId, 400);
    var detailMovements = detailEvents
        .Where(e => e.IsMovement && e.Action is "BUY" or "SELL")
        .Take(120)
        .ToList();
    var closedWithPnl = detailMovements
        .Where(e => e.Action == "SELL" && e.RealizedPnlUsdt is not null)
        .ToList();
    var realizedSum = closedWithPnl.Sum(e => e.RealizedPnlUsdt!.Value);
    var feesSum = closedWithPnl.Where(e => e.FeesUsdt is not null).Sum(e => e.FeesUsdt!.Value);
    var summaryOpen = selectedSession?.OpenSpotQty ?? st.OpenSpotQty;
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center gap-2">
                <span>@(selectedSession is null ? "Resumen hub" : $"Resumen · {(string.IsNullOrWhiteSpace(selectedSession.Settings.LeadNickname) ? ShortId(selectedSession.Settings.LeadPortfolioId) : selectedSession.Settings.LeadNickname)}")</span>
                @if (selectedSession is not null)
                {
                    <button type="button" class="btn btn-sm btn-outline-light" @onclick="ClearMirrorDetail">Todos</button>
                }
            </div>
            <div class="card-body small">
                @if (selectedSession is null)
                {
                    <div><strong>Activos:</strong> @st.ActiveCount / @st.MaxConcurrent</div>
                    <div><strong>Ultimo poll:</strong> @(st.LastPollUtc?.ToString("HH:mm:ss") ?? "—")</div>
                    <div><strong>Delay poll:</strong> @st.RecommendedDelayMs ms @(st.FailStreak > 0 ? $"(backoff fail={st.FailStreak})" : "")</div>
                    <div><strong>Vistos / buy / sell:</strong> @st.SeenOrders / @st.MirroredBuys / @st.MirroredSells</div>
                    <p class="text-muted mb-0 mt-2">Pulsa <strong>Ver</strong> en un mirror para filtrar resumen y traza.</p>
                }
                else
                {
                    <div><strong>Modo:</strong> @(selectedSession.Settings.DryRun ? "dry-run" : "LIVE")</div>
                    <div><strong>Venue:</strong> @VenueLabel(selectedSession.Settings.VenueMode) x@(selectedSession.Settings.FuturesLeverage) @(selectedSession.Settings.LongOnly ? "L" : "L/S")</div>
                    <div><strong>USDT/trade:</strong> @selectedSession.Settings.QuotePerTradeUsdt.ToString("0.##") · max open @selectedSession.Settings.MaxOpenPositions</div>
                    <div><strong>Ultimo poll:</strong> @(selectedSession.LastPollUtc?.ToString("HH:mm:ss") ?? "—")</div>
                    <div><strong>Vistos / buy / sell:</strong> @selectedSession.SeenOrders / @selectedSession.MirroredBuys / @selectedSession.MirroredSells</div>
                    <div><strong>Warm-up:</strong> @(selectedSession.WarmingUp ? "si" : "no") · fail @selectedSession.FailStreak</div>
                    @if (!string.IsNullOrWhiteSpace(selectedSession.LastError))
                    {
                        <div class="text-danger mt-1">@selectedSession.LastError</div>
                    }
                }
                @if (closedWithPnl.Count > 0)
                {
                    <div class="mt-2">
                        <strong>PnL cerrado:</strong>
                        <span class="@(realizedSum >= 0 ? "text-success" : "text-danger")">
                            @(realizedSum >= 0 ? "+" : "")@realizedSum.ToString("0.####") USDT
                        </span>
                        <span class="text-muted"> · fees @feesSum.ToString("0.####") · @closedWithPnl.Count cierre(s)</span>
                    </div>
                }
                @if (summaryOpen.Count > 0)
                {
                    <div class="mt-2"><strong>Posiciones:</strong>
                        @foreach (var kv in summaryOpen)
                        {
                            <div>@kv.Key: @kv.Value.ToString("0.######")</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header">
                @(selectedSession is null ? "Movimientos (todos · persistidos)" : "Movimientos de este mirror · persistidos")
            </div>
            <div class="card-body p-0">
                @if (detailMovements.Count == 0)
                {
                    <p class="text-muted small p-3 mb-0">
                        Aun no hay compras/ventas@(selectedSession is null ? "" : " de este lead"). La traza se guarda en DB y sobrevive reinicios.
                    </p>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 320px; overflow:auto;">
                        <table class="table table-sm mb-0 align-middle">
                            <thead>
                            <tr>
                                <th>UTC</th>
                                <th>Lead</th>
                                <th>Accion</th>
                                <th>Modo</th>
                                <th>Symbol</th>
                                <th class="text-end">Qty / USDT</th>
                                <th class="text-end">Precio</th>
                                <th class="text-end">PnL</th>
                                <th class="text-end">Fees</th>
                                <th class="text-end">Delay</th>
                                <th>Detalle</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var mv in detailMovements)
                            {
                                <tr>
                                    <td class="text-nowrap">@mv.Utc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(mv.LeadNickname) ? ShortId(mv.LeadPortfolioId ?? "") : mv.LeadNickname)</td>
                                    <td>
                                        <span class="badge @(ActionBadgeClass(mv.Action))">@(mv.Action ?? mv.Kind)</span>
                                    </td>
                                    <td class="small">@(mv.Mode ?? mv.Kind)</td>
                                    <td>@(mv.Symbol ?? "—")</td>
                                    <td class="text-end text-nowrap">
                                        @if (mv.QuoteUsdt is not null)
                                        {
                                            <span>~@mv.QuoteUsdt.Value.ToString("0.##") USDT</span>
                                        }
                                        else if (mv.Qty is not null)
                                        {
                                            <span>@mv.Qty.Value.ToString("0.######")</span>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                    <td class="text-end">@(mv.Price?.ToString("0.####") ?? "—")</td>
                                    <td class="text-end text-nowrap">
                                        @if (mv.RealizedPnlUsdt is not null)
                                        {
                                            <span class="badge @PnlBadgeClass(mv.PnlResult)">
                                                @(mv.RealizedPnlUsdt.Value >= 0 ? "+" : "")@mv.RealizedPnlUsdt.Value.ToString("0.####")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (mv.FeesUsdt is not null)
                                        {
                                            <span>@mv.FeesUsdt.Value.ToString("0.####")@(mv.FeeIsEstimated ? "~" : "")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @(mv.DetectDelayMs is null ? "—" : $"{mv.DetectDelayMs}ms")
                                        @if (mv.ExecDelayMs is not null)
                                        {
                                            <span> / @mv.ExecDelayMs ms</span>
                                        }
                                    </td>
                                    <td class="small">@mv.Message</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<details class="mb-4" open="@(!string.IsNullOrWhiteSpace(_selectedLeadId))">
    <summary class="text-muted small">
        Traza completa@(selectedSession is null ? " (hub)" : " del mirror") — persistida en DB
    </summary>
    <div class="card mt-2">
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 360px; overflow:auto;">
                <table class="table table-sm mb-0">
                    <thead>
                    <tr>
                        <th>UTC</th>
                        <th>Lead</th>
                        <th>Tipo</th>
                        <th>Symbol</th>
                        <th>Detalle</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var ev in detailEvents.Take(300))
                    {
                        <tr>
                            <td class="text-nowrap">@ev.Utc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="small">@(string.IsNullOrWhiteSpace(ev.LeadNickname) ? ShortId(ev.LeadPortfolioId ?? "") : ev.LeadNickname)</td>
                            <td>@ev.Kind</td>
                            <td>@(ev.Symbol ?? "—")</td>
                            <td class="small">@ev.Message</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</details>

<div class="alert alert-warning border-0 mb-0" role="status">
    Limite real: Binance no publica fills tick-a-tick. Delay tipico = poll (~1–3s) + refresco del order-history.
    Usa el boton Usar (no pegues IDs con “…”).
</div>

@code {
    private enum BoardTab { Spot, Futures }

    private readonly List<CopyLeadSummary> _leads = [];
    private CopyMirrorSettings _form = new()
    {
        DryRun = true,
        LongOnly = false,
        VenueMode = CopyMirrorVenueMode.Auto,
        FuturesLeverage = 1,
        QuotePerTradeUsdt = 30m,
        MaxOpenPositions = 3,
        PollIntervalMs = 3500
    };
    private BoardTab _boardTab = BoardTab.Spot;
    private string _futuresSort = "PNL";
    private string _futuresNickname = "";
    private string? _selectedLeadId;
    private bool _loadingBoard;
    private bool _starting;
    private string? _error;
    private string? _info;
    private string? _boardNote;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _uiCts;

    private bool CanStart =>
        !string.IsNullOrWhiteSpace(_form.LeadPortfolioId) &&
        _form.LeadPortfolioId.All(char.IsDigit);

    protected override async Task OnInitializedAsync()
    {
        var st = Mirror.GetStatus();
        var first = st.Sessions.FirstOrDefault();
        _form = new CopyMirrorSettings
        {
            DryRun = first?.Settings.DryRun ?? true,
            LongOnly = first?.Settings.LongOnly ?? false,
            VenueMode = first?.Settings.VenueMode ?? CopyMirrorVenueMode.Auto,
            FuturesLeverage = first is { Settings.FuturesLeverage: > 0 }
                ? first.Settings.FuturesLeverage
                : 1,
            QuotePerTradeUsdt = first?.Settings.QuotePerTradeUsdt ?? 30m,
            MaxOpenPositions = first is { Settings.MaxOpenPositions: > 0 }
                ? first.Settings.MaxOpenPositions
                : 3,
            PollIntervalMs = first?.Settings.PollIntervalMs ?? 3500
        };
        _uiCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RefreshLoopAsync(_uiCts.Token);
        await LoadSpotBoardAsync();
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task SwitchToSpotBoardAsync() =>
        _boardTab == BoardTab.Spot && _leads.Count > 0
            ? Task.CompletedTask
            : LoadSpotBoardAsync();

    private Task SwitchToFuturesBoardAsync() =>
        _boardTab == BoardTab.Futures && _leads.Count > 0
            ? Task.CompletedTask
            : LoadFuturesBoardAsync();

    private Task ReloadCurrentBoardAsync() =>
        _boardTab == BoardTab.Spot ? LoadSpotBoardAsync() : LoadFuturesBoardAsync();

    private async Task LoadSpotBoardAsync()
    {
        _loadingBoard = true;
        _boardTab = BoardTab.Spot;
        _error = null;
        _boardNote = "Filtrando leads Spot-compatible...";
        try
        {
            var board = await Mirror.GetSpotCompatibleLeaderboardAsync();
            _leads.Clear();
            _leads.AddRange(board.Leads);
            _boardNote = board.Note;
            if (_leads.Count == 0)
            {
                _error = string.IsNullOrWhiteSpace(board.Note)
                    ? "No hay leads Spot-compatible ahora. Prueba el listado Futures."
                    : board.Note;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _boardNote = null;
        }
        finally
        {
            _loadingBoard = false;
        }
    }

    private async Task LoadFuturesBoardAsync()
    {
        _loadingBoard = true;
        _boardTab = BoardTab.Futures;
        _error = null;
        var nick = _futuresNickname?.Trim() ?? "";
        _boardNote = string.IsNullOrWhiteSpace(nick)
            ? $"Cargando ranking Futures por {_futuresSort}..."
            : $"Buscando “{nick}”...";
        try
        {
            var leads = await Mirror.GetLeaderboardAsync(_futuresSort, nick);
            _leads.Clear();
            _leads.AddRange(leads);
            _boardNote = string.IsNullOrWhiteSpace(nick)
                ? $"Top 30D por {_futuresSort}. Match lead = Futures primero + LONG/SHORT 1:1."
                : $"Resultados para “{nick}” (orden {_futuresSort}).";
            if (_leads.Count == 0)
            {
                _error = string.IsNullOrWhiteSpace(nick)
                    ? "Ranking Futures vacio. Reintenta o cambia el orden."
                    : $"No hay resultados para “{nick}”. Prueba otro nick o pega el portfolio ID abajo.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _boardNote = null;
        }
        finally
        {
            _loadingBoard = false;
        }
    }

    private void OnPortfolioIdInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        _form.LeadPortfolioId = new string(raw.Where(char.IsDigit).ToArray());
        if (!string.Equals(_form.LeadPortfolioId, raw, StringComparison.Ordinal))
        {
            _form.LeadNickname = string.Empty;
        }
    }

    private void SelectLead(CopyLeadSummary lead)
    {
        _form.LeadPortfolioId = lead.LeadPortfolioId;
        _form.LeadNickname = lead.Nickname;
        // Unificado: Match lead (Futures primero) + longs y shorts.
        _form.VenueMode = CopyMirrorVenueMode.Auto;
        _form.LongOnly = false;

        _error = null;
        _info =
            $"Lead listo: {lead.Nickname} ({ShortId(lead.LeadPortfolioId)}). " +
            $"Venue={VenueLabel(_form.VenueMode)} L/S. Pulsa Añadir / iniciar.";
    }

    private bool Selected(CopyLeadSummary lead) =>
        string.Equals(_form.LeadPortfolioId, lead.LeadPortfolioId, StringComparison.Ordinal);

    private async Task StartAsync()
    {
        _error = null;
        _info = null;
        if (!CanStart)
        {
            _error = "Elige un lead con Usar (ID numerico completo). No pegues el ID con puntos suspensivos.";
            return;
        }

        _starting = true;
        try
        {
            // Enteros estables: evita carrera @bind onchange (click sin blur → valor viejo).
            var quote = decimal.Round(Math.Clamp(_form.QuotePerTradeUsdt, 20m, 5000m), 0, MidpointRounding.AwayFromZero);
            var lev = Math.Clamp(_form.FuturesLeverage <= 0 ? 1 : _form.FuturesLeverage, 1, 5);
            var maxOpen = Math.Clamp(_form.MaxOpenPositions <= 0 ? 3 : _form.MaxOpenPositions, 1, 20);
            var poll = Math.Clamp(_form.PollIntervalMs <= 0 ? 3500 : _form.PollIntervalMs, 2500, 30_000);
            _form.QuotePerTradeUsdt = quote;
            _form.FuturesLeverage = lev;
            _form.MaxOpenPositions = maxOpen;
            _form.PollIntervalMs = poll;

            Mirror.UpdateSettings(new CopyMirrorSettings
            {
                Enabled = true,
                DryRun = _form.DryRun,
                LongOnly = _form.LongOnly,
                VenueMode = _form.VenueMode,
                FuturesLeverage = lev,
                LeadPortfolioId = _form.LeadPortfolioId.Trim(),
                LeadNickname = _form.LeadNickname,
                QuotePerTradeUsdt = quote,
                MaxOpenPositions = maxOpen,
                PollIntervalMs = poll
            });

            using var scope = ScopeFactory.CreateScope();
            await Mirror.PollOnceAsync(scope.ServiceProvider);

            var st = Mirror.GetStatus();
            var saved = st.Sessions.FirstOrDefault(x =>
                string.Equals(x.Settings.LeadPortfolioId, _form.LeadPortfolioId.Trim(), StringComparison.Ordinal));
            var savedQuote = saved?.Settings.QuotePerTradeUsdt ?? quote;
            _info =
                $"Mirror {(_form.DryRun ? "DRY-RUN" : "LIVE")} [{VenueLabel(_form.VenueMode)}] " +
                $"{savedQuote:0} USDT/trade x{lev}. Activos={st.ActiveCount}/{st.MaxConcurrent}. " +
                (string.IsNullOrWhiteSpace(st.LastError) ? "Warm-up/eventos abajo." : $"Aviso: {st.LastError}");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo iniciar: {ex.Message}";
        }
        finally
        {
            _starting = false;
        }
    }

    private Task StopAllAsync()
    {
        Mirror.Stop();
        _info = "Todos los mirrors detenidos.";
        _error = null;
        return Task.CompletedTask;
    }

    private Task StopOneAsync(string leadPortfolioId)
    {
        Mirror.Stop(leadPortfolioId);
        if (string.Equals(_selectedLeadId, leadPortfolioId, StringComparison.Ordinal))
        {
            _selectedLeadId = null;
        }

        _info = $"Mirror detenido: {ShortId(leadPortfolioId)}";
        _error = null;
        return Task.CompletedTask;
    }

    private void ToggleMirrorDetail(string leadPortfolioId)
    {
        _selectedLeadId = string.Equals(_selectedLeadId, leadPortfolioId, StringComparison.Ordinal)
            ? null
            : leadPortfolioId;
    }

    private void ClearMirrorDetail() => _selectedLeadId = null;

    private static string VenueLabel(CopyMirrorVenueMode mode) => mode switch
    {
        CopyMirrorVenueMode.SpotOnly => "Spot",
        CopyMirrorVenueMode.FuturesOnly => "Futures",
        CopyMirrorVenueMode.Auto => "Match",
        _ => mode.ToString()
    };

    private static string VenueHelp(CopyMirrorVenueMode mode) => mode switch
    {
        CopyMirrorVenueMode.SpotOnly => "Solo Spot: BUY/SELL long. No copia shorts.",
        CopyMirrorVenueMode.FuturesOnly => "Solo Futures: LONG y SHORT 1:1 con el lead.",
        CopyMirrorVenueMode.Auto =>
            "Match lead: misma operacion (LONG/SHORT). Futures primero; Spot solo si el par no existe en Futures.",
        _ => string.Empty
    };

    private static string ShortId(string id) =>
        string.IsNullOrEmpty(id) ? "" : (id.Length <= 10 ? id : id[..6] + "…" + id[^4..]);

    private static string ActionBadgeClass(string? action) => action switch
    {
        "BUY" => "text-bg-success",
        "SELL" => "text-bg-danger",
        "SKIP" => "text-bg-secondary",
        _ => "text-bg-dark"
    };

    private static string PnlBadgeClass(string? result) => result switch
    {
        "profit" => "text-bg-success",
        "loss" => "text-bg-danger",
        "breakeven" => "text-bg-secondary",
        _ => "text-bg-dark"
    };

    public async ValueTask DisposeAsync()
    {
        if (_uiCts is not null)
        {
            await _uiCts.CancelAsync();
            _uiCts.Dispose();
        }
        _timer?.Dispose();
    }
}
